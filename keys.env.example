# Copy to keys.env (gitignored) and fill in. Never commit real values.
# Loaded with dotenv (path: "keys.env") by the pipeline and by next.config.ts.

# GitHub personal access token (public repo read; raises the API limit to 5000/hr)
GITHUB_TOKEN=
# Google Gemini API key (pipeline words + classification; search parsing is cached)
GEMINI_API_KEY=
# Postgres connection string (Tiger Data). Optional. The pipeline always writes JSON; with this set,
# scripts/load-db.mjs loads that JSON into Postgres and the topic search reads it from there.
DATABASE_URL=
# People Data Labs API key. Optional: without it enrichment falls back to the Devpost tagline.
PDL_API_KEY=

# App switches (optional)
# DATA_SOURCE=sample        # sample | real  (real reads data/builders.json)
# ALLOW_LIVE_GEMINI=0       # 1 lets /api/parse call Gemini on a cache miss (off for demos)
